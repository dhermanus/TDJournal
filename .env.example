# Claude API key: powers diary analysis, day review, weekly summary, and the Brain chat (get one at console.anthropic.com)
ANTHROPIC_API_KEY=
# Alpaca market-data key id: powers the intraday price charts (free account at alpaca.markets)
APCA_API_KEY_ID=
# Alpaca market-data secret key
APCA_API_SECRET_KEY=
# Optional. Defaults to "iex", which works on a free Alpaca account. Set to "sip"
# only if your key has a paid market-data subscription.
ALPACA_DATA_FEED=
# IANA timezone of the MT5 broker server (not your PC or display timezone).
# ICMarketsSC-Demo commonly uses Europe/Athens; confirm with IC Markets before relying on historical conversions.
# This setting handles historical daylight-saving transitions.
MT5_SERVER_TIMEZONE=Europe/Athens
# Optional. Auth defaults OFF so setup.bat + launch.bat keep working exactly
# as before on localhost. For Docker/Dockge or any non-localhost deployment, set
# TDJ_AUTH=required and choose a strong private password. The server refuses to
# start if auth is required but no password/hash exists.
# TDJ_AUTH=required
# TDJ_PASSWORD=change-this-to-a-strong-password
